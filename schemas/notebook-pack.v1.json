{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notebook-pack.v1",
  "description": "Manifest for a deterministic, provenance-bearing source set prepared for an optional external synthesis provider.",
  "type": "object",
  "required": [
    "schema",
    "notebook",
    "generated_at",
    "generator",
    "sources",
    "content_hash"
  ],
  "properties": {
    "schema": {
      "const": "notebook-pack.v1"
    },
    "notebook": {
      "type": "object",
      "required": ["id", "purpose"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "mq-agent"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "classification", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "overview",
              "architecture",
              "decision",
              "contract",
              "roadmap",
              "lesson",
              "review",
              "observation"
            ]
          },
          "classification": {
            "type": "string",
            "enum": ["public-safe", "approved-external"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision": {
            "type": "object",
            "required": ["repository", "commit", "dirty"],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{7,64}$"
              },
              "dirty": {
                "description": "True when this source had uncommitted working-tree changes, so sha256 does not describe the named commit.",
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "content_hash": {
      "description": "SHA-256 over canonical source metadata and content; generated_at is excluded.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
