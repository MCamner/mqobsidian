{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mq.execution-outcome.v1",
  "description": "Observed result of one MQ execution. Records runtime facts for later inspection; it does not score, promote, or change routing.",
  "type": "object",
  "required": [
    "schema",
    "execution_id",
    "timestamp",
    "task_class",
    "selected_route",
    "selected_model",
    "context_sources",
    "context_size",
    "duration_ms",
    "result_status",
    "fallback_used",
    "retry_count"
  ],
  "properties": {
    "schema": { "const": "mq.execution-outcome.v1" },
    "execution_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "task_class": { "type": "string", "minLength": 1 },
    "selected_route": { "type": "string", "minLength": 1 },
    "selected_model": { "type": "string", "minLength": 1 },
    "context_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context_size": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "result_status": {
      "type": "string",
      "enum": ["succeeded", "partial", "failed", "cancelled"]
    },
    "fallback_used": { "type": "boolean" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "quality_signal": {
      "type": "string",
      "enum": ["accepted", "rejected", "unknown"]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
