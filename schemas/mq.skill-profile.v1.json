{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "status",
    "supported_targets",
    "scope",
    "intents",
    "domains",
    "risks",
    "required_for",
    "supersedes",
    "description"
  ],
  "properties": {
    "schema": {
      "const": "mq.skill-profile.v1"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ]
    },
    "supported_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude"
        ]
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "repo",
          "stack"
        ]
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "required_for": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
