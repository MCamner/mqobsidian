# Materialized truth exports: generated by scripts/build-truth-exports.py.
# The bundle is a build artifact; schemas and examples are the tracked contract.
/exports/

# Local NotebookLM state and generated packs. Only the consumer profile,
# schemas, templates, policy, and sanitized examples are publishable.
/.notebooklm/

# repo-signal packs: regenerated per checkout (`repo-signal export .`), never
# committed. The symbol index names its checkout and expires after 24 hours.
/.repo-signal/
